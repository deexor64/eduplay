// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  userID      String    @id @default(uuid())
  fullName    String
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  password    String
  status      Status    @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admin   Admin?   @relation("admin")
  teacher Teacher? @relation("teacher")
  parent  Parent?  @relation("parent")
  student Student? @relation("student")
}

model Admin {
  adminID       String @id @default(uuid())
  indexNumber   String @unique
  email         String @unique
  phoneNumber   String @unique
  displayPicUrl String @default("/images/avatar.png")

  userID String @unique
  user   User   @relation("admin", fields: [userID], references: [userID])
}

model Teacher {
  teacherID     String @id @default(uuid())
  indexNumber   String @unique
  email         String @unique
  phoneNumber   String @unique
  displayPicUrl String @default("/images/avatar.png")

  userID String @unique
  user   User   @relation("teacher", fields: [userID], references: [userID])

  classes Class[] @relation("manageClass")

  lessons Lesson[] @relation("lessonCreator")
}

model Parent {
  parentID      String @id @default(uuid())
  email         String @unique
  phoneNumber   String @unique
  displayPicUrl String @default("/images/avatar.png")

  userID String @unique
  user   User   @relation("parent", fields: [userID], references: [userID])
}

model Student {
  studentID     String @id @default(uuid())
  indexNumber   String @unique
  email         String
  phoneNumber   String
  displayPicUrl String @default("/images/avatar.png")

  classID String?
  class   Class?  @relation("enroll", fields: [classID], references: [classID])

  userID String @unique
  user   User   @relation("student", fields: [userID], references: [userID])
}

model Class {
  classID     String   @id @default(uuid())
  name        String?
  grade       Int
  classLetter String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managedBy String
  teacher   Teacher @relation("manageClass", fields: [managedBy], references: [teacherID])

  students Student[] @relation("enroll")

  @@unique([grade, classLetter])
}

model Lesson {
  lessonID      String   @id @default(uuid())
  title         String
  coverImageUrl String? // url
  description   String?
  activityData  Json?
  options       Json? // this may devided into columns
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy String
  teacher   Teacher @relation("lessonCreator", fields: [createdBy], references: [teacherID])
}

model templates {
  templateID   String @id @default(uuid())
  templateCode String
  title        String
  description  String
  templateType String
}
