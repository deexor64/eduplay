// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userID      String   @id @default(uuid())
  fullName    String 
  firstName   String 
  lastName    String 
  dateOfBirth DateTime?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  admin       Admin?   @relation("admin")
  teacher     Teacher? @relation("teacher")
  parent      Parent?  @relation("parent")
  student     Student? @relation("student")
  
}

model Admin {
  adminID     String   @id @default(uuid())
  indexNumber String   @unique
  email       String   @unique
  phoneNumber String   @unique
  
  userID      String   @unique
  user        User     @relation("admin", fields: [userID], references: [userID])
}

model Teacher {
  teacherID   String   @id @default(uuid())
  indexNumber String   @unique
  email       String   @unique
  phoneNumber String   @unique
  
  userID      String   @unique
  user        User     @relation("teacher", fields: [userID], references: [userID])
}

model Parent {
  parentID   String   @id @default(uuid())
  email       String   @unique
  phoneNumber String   @unique
  
  userID      String   @unique
  user        User     @relation("parent", fields: [userID], references: [userID])
}

model Student {
  studentID   String   @id @default(uuid())
  indexNumber String   @unique
  email       String 
  phoneNumber String
  
  userID      String   @unique
  user        User     @relation("student", fields: [userID], references: [userID])
}
