// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  TEACHER
  STUDENT
}

enum Subject {
  COMMON
  MATHEMATICS
  SCIENCE
  ENGLISH
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  userID        String     @id @default(uuid())
  firstName     String
  lastName      String
  email         String     @unique 
  status        UserStatus @default(ACTIVE)
  displayPicUrl String     @default("/images/avatar.png")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  teacher Teacher? @relation("teacher")
  student Student? @relation("student")

  notificationReads NotificationRead[]
}

enum TeacherRole {
  ADMIN
  TEACHER
  DEMONSTRATOR
}

model Teacher {
  teacherID   String      @id @default(uuid())
  indexNumber String      @unique
  role        TeacherRole @default(TEACHER)

  userID String @unique
  user   User   @relation("teacher", fields: [userID], references: [userID])

  activity Activity[] @relation("activityCreator")
  
  notifications Notification[] @relation("notifyTeacher")
}

model Student {
  studentID   String @id @default(uuid())
  indexNumber String @unique
  grade       Int

  userID String @unique
  user   User   @relation("student", fields: [userID], references: [userID])
  
  progress Progress[] @relation("progress")
  
  notifications Notification[] @relation("notifyStudent")
}

enum ActivityDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ActivityStatus {
  UNPUBLISHED
  PUBLISHED
  DELETED
}

model Activity {
  activityID   String             @id @default(uuid())
  section      String
  title        String
  instructions String
  activityData Json
  status       ActivityStatus     @default(UNPUBLISHED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  isScored     Boolean            @default(false)
  difficulty   ActivityDifficulty @default(EASY)
  grade        Int                @default(1)
  subject      Subject            @default(COMMON)

  templateCode String
  template     Template @relation("activityTemplate", fields: [templateCode], references: [templateCode])

  createdBy String
  teacher   Teacher @relation("activityCreator", fields: [createdBy], references: [teacherID])

  progress Progress[] @relation("progressOf")
}

model Template {
  templateID     String @id @default(uuid())
  templateCode   String @unique()
  title          String @unique()
  description    String
  templateType   String
  sampleActivity Json

  activity Activity[] @relation("activityTemplate")
}

model Progress {
  progressID String @id @default(uuid())
  baseScore  Int    @default(0)
  maxScore   Int    @default(100)
  summery    String
  data       Json
  createdAt     DateTime   @default(now())

  progressFor String
  student     Student @relation("progress", fields: [progressFor], references: [studentID])

  progressOf String
  activity   Activity @relation("progressOf", fields: [progressOf], references: [activityID])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  notificationID String   @id @default(uuid())
  title          String
  message        String
  type           NotificationType
  createdAt      DateTime @default(now())
  
  group          UserType?

  forStudent     String?
  student        Student? @relation("notifyStudent", fields: [forStudent], references: [studentID])

  forTeacher     String?
  teacher        Teacher? @relation("notifyTeacher", fields: [forTeacher], references: [teacherID])

  reads NotificationRead[]
}

model NotificationRead {
  notificationReadID String   @id @default(uuid())
  notificationID     String
  userID             String
  readAt             DateTime @default(now())

  notification Notification @relation(fields: [notificationID], references: [notificationID])
  user         User         @relation(fields: [userID], references: [userID])

  @@unique([notificationID, userID])
}
