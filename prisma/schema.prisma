// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  TEACHER
  PARENT
  STUDENT
}

enum Subject {
  COMMON
  MATHEMATICS
  SCIENCE
  ENGLISH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model User {
  userID        String     @id @default(uuid())
  firstName     String
  lastName      String
  phoneNumber   String?
  dateOfBirth   DateTime?
  password      String
  status        UserStatus @default(ACTIVE)
  displayPicUrl String     @default("/images/avatar.png")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  teacher Teacher? @relation("teacher")
  parent  Parent?  @relation("parent")
  student Student? @relation("student")
}

enum TeacherRole {
  MASTER
  ADMIN
  TEACHER
  DEMONSTRATOR
}

model Teacher {
  teacherID   String      @id @default(uuid())
  indexNumber String      @unique
  email       String      @unique
  role        TeacherRole @default(TEACHER)
  subject     Subject     @default(COMMON)

  userID String @unique
  user   User   @relation("teacher", fields: [userID], references: [userID])

  activity Activity[] @relation("activityCreator")
}

enum StudentClass {
  A
  B
  C
  D
  E
  F
}

model Student {
  studentID   String @id @default(uuid())
  indexNumber String @unique
  email       String
  grade       Int
  class       StudentClass

  userID String @unique
  user   User   @relation("student", fields: [userID], references: [userID])

  myParent String @unique
  parent   Parent @relation("parent", fields: [myParent], references: [parentID])

  progress Progress[] @relation("progress")
}

model Parent {
  parentID String @id @default(uuid())
  email    String @unique

  userID String @unique
  user   User   @relation("parent", fields: [userID], references: [userID])

  myChildren Student[] @relation("parent")
}

enum ActivityDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ActivityStatus {
  UNPUBLISHED
  PUBLISHED
  DELETED
}

model Activity {
  activityID   String             @id @default(uuid())
  section      String
  title        String
  instructions String
  activityData Json
  status       ActivityStatus     @default(UNPUBLISHED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  isScored     Boolean            @default(false)
  difficulty   ActivityDifficulty @default(EASY)
  grade        Int                @default(1)
  subject      Subject            @default(COMMON)

  templateCode String
  template     Template @relation("activityTemplate", fields: [templateCode], references: [templateCode])

  createdBy String
  teacher   Teacher @relation("activityCreator", fields: [createdBy], references: [teacherID])

  progress Progress[] @relation("progressOf")
}

model Template {
  templateID     String @id @default(uuid())
  templateCode   String @unique()
  title          String @unique()
  description    String
  templateType   String
  sampleActivity Json

  activity Activity[] @relation("activityTemplate")
}

model Progress {
  progressID String @id @default(uuid())
  baseScore  Int    @default(0)
  maxScore   Int    @default(100)
  summery    String
  data       Json
  createdAt     DateTime   @default(now())

  progressFor String
  student     Student @relation("progress", fields: [progressFor], references: [studentID])

  progressOf String
  activity   Activity @relation("progressOf", fields: [progressOf], references: [activityID])
}
